# Copy to .env (git-ignored) and fill in only what you need. Never commit .env.

# mock (default, free, offline) or real (calls paid APIs). The --real flag also works per script.
LAB_MODE=mock

# Real mode: Anthropic API (https://console.anthropic.com). Billed per token.
ANTHROPIC_API_KEY=
# Default is claude-opus-5-5. claude-haiku-5-5 is about 40x cheaper for learning runs.
LLM_MODEL=claude-opus-5-5
# Optional: low | medium | high | xhigh | max
LLM_EFFORT=
# 1 = let the API retry on a fallback model if a safety classifier declines (beta feature)
LLM_FALLBACKS=1

# Retrieval models: mock (LSA + rule reranker, offline) or local (neural models via fastembed,
# free but downloads ~150 MB from Hugging Face; needs requirements-optional.txt)
RAG_MODELS=mock

# Human approval for write actions: ask | auto-yes | auto-no
APPROVAL=ask

# Langfuse tracing (cloud.langfuse.com or self-hosted). Leave empty for local traces only.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# pgvector (script 05). Matches docker-compose.yml.
PGVECTOR_URL=
# PGVECTOR_URL=postgresql://lab:lab@localhost:5432/lab

# Azure AI Search (script 05). Costs money.
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_KEY=

# Azure AI Foundry (script 10 --real). Uses `az login` credentials, no key here.
FOUNDRY_PROJECT_ENDPOINT=
FOUNDRY_MODEL=
